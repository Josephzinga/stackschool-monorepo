{
  "private": true,
  "name": "stackschool-monorepo",
  "version": "1.0.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "resolutions": {
    "react": "^19.2.3"
  },
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "dev:web": "pnpm --filter @stackschool/web run dev",
    "dev:mobile": "pnpm --filter @stackschool/mobile run start",
    "db:generate": "pnpm --filter @stackschool/db run generate",
    "codegen": "graphql-codegen --config codegen.ts",
    "dev:api": "nx run-many --targets=dev --projects=@stackschool/shared,@stackschool/db & nx dev @stackschool/api-nest",
    "build:api": "nx build @stackschool/api-nest",
    "build:all": "nx run-many -t build",
    "build:db": "nx run-many -t build --projects=db-operations,db-auth,db-academic,db-core"
  },
  "devDependencies": {
    "@0no-co/graphqlsp": "^1.15.2",
    "@babel/core": "^7.20.0",
    "@eslint/eslintrc": "^3",
    "@graphql-codegen/cli": "^6.1.1",
    "@graphql-codegen/typescript": "^5.0.7",
    "@graphql-codegen/typescript-operations": "^5.0.7",
    "@graphql-codegen/typescript-react-query": "^6.1.1",
    "@graphql-codegen/typescript-resolvers": "^5.1.5",
    "@parcel/watcher": "^2.5.6",
    "@tailwindcss/postcss": "^4.1.17",
    "@tanstack/eslint-plugin-query": "^5.91.2",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog",
    "eslint": "^9",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.1.2",
    "nx": "23.0.1"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "ts-node-dev": "^2.0.0"
  },
  "packageManager": "pnpm@11.9.0"
}
