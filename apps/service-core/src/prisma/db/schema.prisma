generator client {
  provider            = "prisma-client"
  output              = "./generated"
  engineType          = "client"
  importFileExtension = "js"
  moduleFormat        = "cjs"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

model School {
  id               String          @id @default(uuid())
  name             String
  slug             String?         @unique
  address          String
  code             String          @unique
  planId           String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?
  invitationCode   String?
  logo             String?
  motto            String?
  orangeMerchantId String?
  paymentApiKey    String?
  walletBalance    Float           @default(0)
  parentStudent    ParentStudent[]
  profiles         SchoolProfile[]
  settings         SchoolSettings?
  memberships      SchoolUser[]
  students         Student[]
  subscriptions    Subscription[]
}

model TempSchoolUser {
  id       String     @id @default(uuid())
  schoolId String
  userId   String
  role     SchoolRole
  parent   Parent?
  staff    Staff?
  student  Student?
  teacher  Teacher?

  @@unique([userId, schoolId])
  @@index([userId, schoolId])
}

/// *
/// * pivot User <-> School
model SchoolUser {
  id            String                 @id @default(uuid())
  schoolId      String
  userId        String
  isActive      Boolean                @default(true)
  role          SchoolRole
  isOwner       Boolean                @default(false)
  createdAt     DateTime               @default(now())
  Parent        Parent?
  schoolProfile SchoolProfile?
  school        School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  permissions   SchoolUserPermission[]
  staff         Staff?
  student       Student?
  teacher       Teacher?

  @@unique([schoolId, userId])
  @@index([schoolId])
  @@index([userId])
  @@index([role])
}

model SchoolProfile {
  id           String     @id @default(cuid())
  firstName    String
  lastName     String
  address      String?
  avatarUrl    String?
  bio          String?
  schoolUserId String     @unique
  schoolId     String
  gender       Gender
  school       School     @relation(fields: [schoolId], references: [id])
  schoolUser   SchoolUser @relation(fields: [schoolUserId], references: [id])
}

model SchoolSettings {
  id             String @id @default(cuid())
  schoolId       String @unique
  lessonDuration Int    @default(50)
  startHour      Int    @default(8)
  endHour        Int    @default(18)
  daysOfWeek     Day[]
  breakStartHour Int    @default(12)
  breakDuration  Int    @default(60)
  school         School @relation(fields: [schoolId], references: [id])
}

model Permission {
  id          String            @id @default(cuid())
  action      PermissionAction
  subject     PermissionSubject
  module      PermissionModule  // garde le groupement pour ton UI existante
  name        String            // libellé lisible, ex: "Saisir les notes"
  description String?
  conditions  Json?             // ex: { "teacherId": "${user.id}" } — optionnel

  @@unique([action, subject])
  schoolUserPermissions SchoolUserPermission[]
}

model SchoolUserPermission {
  id           String     @id @default(cuid())
  schoolUserId String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  schoolUser   SchoolUser @relation(fields: [schoolUserId], references: [id], onDelete: Cascade)

  @@unique([schoolUserId, permissionId])
}

model StudentDisciplinaryAction {
  id        String           @id @default(cuid())
  studentId String
  type      DisciplinaryType
  reason    String
  startDate DateTime         @db.Date
  endDate   DateTime?        @db.Date
  createdAt DateTime         @default(now())
  student   Student          @relation(fields: [studentId], references: [id])
}

/// * Parent
model Parent {
  id                String             @id @default(uuid())
  schoolUserId      String?            @unique
  profession        String?
  isDelegate        Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  contactPreference ContactPreference? @default(WHATSAPP)
  needAdminConfirm  Boolean            @default(false)
  tempSchoolUserId  String?            @unique
  schoolUser        SchoolUser?        @relation(fields: [schoolUserId], references: [id], onDelete: Cascade)
  tempSchoolUser    TempSchoolUser?    @relation(fields: [tempSchoolUserId], references: [id], onDelete: Cascade)
  students          ParentStudent[]
}

/// *
/// * Etudiant
model Student {
  id                     String                      @id @default(uuid())
  matricule              String
  enrollmentYear         String?
  enrollmentDate         DateTime?
  studentNumber          Int                         @default(autoincrement())
  bloodGroup             String?
  allergies              String?
  medicalCondition       String?
  schoolUserId           String?                     @unique
  birthDate              DateTime                    @db.Date
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  deletedAt              DateTime?
  birthPlace             String?
  nationality            String?
  previousClass          String?
  previousLevel          String?
  birthCertificateNumber String?
  previousSchool         String?
  schoolId               String
  classId                String
  transportMode          TransportMode               @default(WALK)
  status                 StudentStatus               @default(ACTIVE)
  needAdminConfirm       Boolean                     @default(false)
  tempSchoolUserId       String?                     @unique
  parentStudent          ParentStudent[]
  school                 School                      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolUser             SchoolUser?                 @relation(fields: [schoolUserId], references: [id], onDelete: Cascade)
  tempSchoolUser         TempSchoolUser?             @relation(fields: [tempSchoolUserId], references: [id], onDelete: Cascade)
  disciplinaryActions    StudentDisciplinaryAction[]

  @@unique([matricule, schoolId])
  @@index([schoolUserId])
  @@index([schoolId])
}

/// *
/// * Parent - Student pivot
model ParentStudent {
  id               String       @id @default(cuid())
  studentId        String
  createdAt        DateTime     @default(now())
  parentId         String
  relationType     RelationType
  needAdminConfirm Boolean      @default(false)
  schoolId         String
  parent           Parent       @relation(fields: [parentId], references: [id], onDelete: Cascade)
  school           School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student          Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
}

model Teacher {
  id                 String          @id @default(uuid())
  schoolUserId       String?         @unique
  diploma            String?
  experience         String?
  hireDate           DateTime?
  isActive           Boolean         @default(true)
  salary             Float?
  department         String?
  specialization     String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?
  bio                String?
  cvUrl              String?
  needAdminConfirm   Boolean         @default(false)
  tempSchoolUserId   String?         @unique
  pendingAssignments Json?
  schoolUser         SchoolUser?     @relation(fields: [schoolUserId], references: [id], onDelete: Cascade)
  tempSchoolUser     TempSchoolUser? @relation(fields: [tempSchoolUserId], references: [id], onDelete: Cascade)

  @@map("Teachers")
}

model Staff {
  id               String         @id @default(uuid())
  schoolUserId     String?        @unique
  hireDate         DateTime?
  position         StaffPosition  @default(OTHER)
  positionOther    String?
  salary           Float?
  department       String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  needAdminConfirm Boolean        @default(false)
  tempSchoolUserId String?         @unique
  schoolUser       SchoolUser?    @relation(fields: [schoolUserId], references: [id], onDelete: Cascade)
  tempSchoolUser   TempSchoolUser? @relation(fields: [tempSchoolUserId], references: [id], onDelete: Cascade)

  @@index([schoolUserId])
  @@index([position])
}

model Invite {
  id          String     @id @default(cuid())
  email       String?
  schoolId    String
  studentId   String?
  token       String?    @unique
  relation    String?
  createdAt   DateTime   @default(now())
  expiresAt   DateTime
  used        Boolean    @default(false)
  role        SchoolRole
  message     String
  phoneNumber String?
  code        String?    @unique

  @@index([schoolId])
  @@index([studentId])
}

model Subscription {
  id          String    @id @default(cuid())
  schoolId    String
  planId      String
  stripeSubId String?
  status      String
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  createdAt   DateTime  @default(now())
  plan        Plan      @relation(fields: [planId], references: [id])
  school      School    @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
}

/// *
/// * Billing
model Plan {
  id           String         @id @default(cuid())
  name         String
  stripeId     String?
  priceCents   Int
  features     String?
  createdAt    DateTime       @default(now())
  subscription Subscription[]
}

enum DisciplinaryType {
  SUSPENSION
  EXPULSION
  WARNING
}

enum SchoolRole {
  ADMIN
  TEACHER
  STUDENT
  PARENT
  STAFF
}

enum GlobalRole {
  SUPER_ADMIN
  USER
}

enum RelationType {
  FATHER
  MOTHER
  GUARDIAN
  UNCLE
  OTHER
  GRAND_MOTHER
  GRAND_FATHER
  AUNT
}

enum ContactPreference {
  WHATSAPP
  EMAIL
  PHONE
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum StudentStatus {
  ACTIVE
  SUSPENDED
  EXPELLED
  TRANSFERRED
  DROPPED_OUT
  GRADUATED
  INACTIVE
  DECEASED
}

enum TransportMode {
  BUS
  WALK
  CAR
  MOTO
  TAXI
  PARENT
  OTHER
}

enum GroupType {
  SOLO
  MULTIPLE
}

enum SessionStatus {
  FINISHED
  STARTED
}

enum PermissionAction {
  MANAGE   // wildcard CASL : toutes les actions sur le subject
  CREATE
  READ
  UPDATE
  DELETE
  MARK     // ex: présences
  PUBLISH  // ex: bulletins
  EXPORT   // ex: rapports
  CONFIRM
}

enum PermissionSubject {
  STUDENT
  TEACHER
  PARENT
  STAFF
  CLASS
  SUBJECT
  LESSON
  GRADE
  BULLETIN
  TIMETABLE
  EXAM
  ENROLLMENT
  ATTENDANCE_RECORD
  PAYMENT
  PAYROLL
  FINANCIAL_REPORT
  SCHOOL_SETTINGS
  SCHOOL_USER_PERMISSION
  ALL      // correspond au subject 'all' de CASL
}

enum PermissionModule {
  ATTENDANCE
  ACADEMICS
  USERS
  FINANCE
  ENROLLMENT
  SETTINGS
}

enum StaffPosition {
  SECRETARY
  GUARDIAN
  SUPERVISOR
  ACCOUNTANT
  LIBRARIAN
  NURSE
  CLEANER
  MAINTENANCE
  OTHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}
