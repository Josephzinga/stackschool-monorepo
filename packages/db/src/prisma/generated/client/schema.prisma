generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String              @id @default(cuid())
  email             String?             @unique
  password          String?
  globalRole        GlobalRole?         @default(USER)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?
  hasMembership     Boolean?            @default(false)
  profileCompleted  Boolean?            @default(false)
  username          String?             @unique
  isVerified        Boolean?
  phoneNumber       String?             @unique
  emailVerifiedAt   DateTime?
  emailVerified     Boolean?            @default(false)
  isActive          Boolean             @default(true)
  accounts          Account[]
  payments          Payment[]
  profile           Profile?
  memberships       SchoolUser[]
  sessions          Session[]
  VerificationCode  VerificationCode[]
  VerificationToken VerificationToken[]

  @@index([email])
}

model Profile {
  id        String   @id @default(cuid())
  firstname String?
  lastname  String?
  gender    Gender?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String   @unique
  photo     String?
  address   String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  student   Student?
}

model School {
  id                 String              @id @default(cuid())
  name               String
  slug               String?             @unique
  address            String
  code               String?             @unique
  planId             String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  inviationCode      String?
  logo               String?
  motto              String?
  assessments        Assessment[]
  orangeMerchantId   String?
  paymentApiKey      String?
  walletBalance      Float               @default(0)
  attendances        Attendance[]
  attendanceSessions AttendanceSession[]
  classes            Class[]
  lessons            Lesson[]
  room               Room[]
  payment            Payment[]
  memberships        SchoolUser[]
  students           Student[]
  Subject            Subject[]
  subscriptions      Subscription[]
  settings           SchoolSettings?
}

// Paramétre de l'ecole

model SchoolSettings {
  id String @id @default(cuid())

  schoolId       String @unique
  lessonDuration Int    @default(50) // durée d'une lesson (5O min)
  startHour      Int    @default(8) // début de cours (8 heure)
  endHour        Int    @default(18) // fin de cours (18 heure)
  daysOfWeek     Day[]
  breakStartHour Int    @default(12) // 12 heure (heure de pause)
  breakDuration  Int    @default(60) // 60 duration de la pause (60 min)
  school         School @relation(fields: [schoolId], references: [id])
}

// table de permission 
model Permission {
  id          String           @id @default(cuid())
  code        PermissionCode   @unique // L'identifiant strict, ex: "MARK_STUDENT_ATTENDANCE"
  name        String // Nom lisible, ex: "Faire l'appel des élèves"
  module      PermissionModule // Pour grouper dans l'UI, ex: "ATTENDANCE", "FINANCE", "GRADES"
  description String? // Explication détaillée pour l'admin

  // Relation inverse : Une permission appartient à plusieurs utilisateurs
  schoolUserPermissions SchoolUserPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SchoolUserPermission {
  id           String @id @default(cuid())
  schoolUserId String
  permissionId String

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  schoolUser SchoolUser @relation(fields: [schoolUserId], references: [id], onDelete: Cascade)

  @@unique([schoolUserId, permissionId])
}

/// *
/// * pivot User <-> School
model SchoolUser {
  id                 String                 @id @default(cuid())
  schoolId           String
  userId             String
  isActive           Boolean                @default(true)
  role               SchoolRole
  isOwner            Boolean                @default(false)
  createdAt          DateTime               @default(now())
  Parent             Parent?
  school             School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  staff              Staff?
  student            Student?
  teacher            Teacher?
  attendance         Attendance[]
  attendanceSessions AttendanceSession[]
  permissions        SchoolUserPermission[]

  @@unique([schoolId, userId])
  @@index([schoolId])
  @@index([userId])
  @@index([role])
}

/// *
/// * Subject:  pivot ClassSubjects (explicit)
model Subject {
  id            String          @id @default(cuid())
  name          String
  code          String?
  category      SubjectCategory @default(GENERAL)
  mainTeacherId String?
  schoolId      String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  classSubjects ClassSubjects[]
  school        School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  mainTeacher   Teacher?        @relation("MainTeacher", fields: [mainTeacherId], references: [id])

  @@unique([name, schoolId])
  @@unique([code, schoolId])
  @@index([schoolId])
}

/// *
/// * Pivot explicit pour Class <-> Subject
model ClassSubjects {
  id          String             @id @default(cuid())
  groupId     String
  schoolId    String
  weeklyHours Int?
  coefficient Int                @default(1)
  subjectId   String
  assessments Assessment[]
  group       Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subject     Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  assignments TeacherAssignment?
  attendances Attendance[]

  @@unique([groupId, subjectId])
  @@index([groupId])
  @@index([subjectId])
}

model TeacherAssignment {
  id             String @id @default(cuid())
  teacherId      String
  classSubjectId String
  schoolId       String

  teacher      Teacher       @relation(fields: [teacherId], references: [id])
  classSubject ClassSubjects @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)

  lessons Lesson[]

  @@unique([schoolId, classSubjectId, teacherId])
  @@unique([classSubjectId])
  @@unique([schoolId, classSubjectId])
  @@index([schoolId])
}

model Class {
  id            String    @id @default(cuid())
  name          String
  level         String
  section       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  schoolId      String
  teacherId     String?
  defaultRoomId String?
  supervisorId  String?
  groupId       String
  group         Group     @relation(fields: [groupId], references: [id])
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  supervisor    Teacher?  @relation("ClassSupervisor", fields: [supervisorId], references: [id])
  students      Student[]
  defaultRoom   Room?     @relation("DefaultRoom", fields: [defaultRoomId], references: [id], onDelete: SetNull)

  @@unique([name, schoolId])
  @@unique([defaultRoomId])
  @@index([schoolId])
}

model Group {
  id   String @id @default(cuid())
  name String

  type          GroupType       @default(SOLO)
  classes       Class[]
  classSubjects ClassSubjects[]

  schoolId String

  @@unique([name, schoolId])
  @@index([schoolId])
}

// *
// * Salle
model Room {
  id              String   @id @default(cuid())
  name            String
  code            String?
  type            String?  @default("CLASSIC")
  capacity        Int?
  defaultForClass Class?   @relation("DefaultRoom")
  lessons         Lesson[]
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])

  @@unique([name, schoolId])
  @@unique([code, schoolId])
  @@index([schoolId])
}

model Lesson {
  id                  String            @id @default(cuid())
  title               String?
  subtitle            String?
  startTime           DateTime          @db.Time()
  status              LessonStatus      @default(PLANNED)
  day                 Day
  endTime             DateTime          @db.Time()
  schoolId            String
  roomId              String?
  teacherAssignmentId String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime?         @updatedAt
  deletedAt           DateTime?
  courseSessions      CourseSession[]
  teacherAssignment   TeacherAssignment @relation(fields: [teacherAssignmentId], references: [id], onDelete: Cascade)
  school              School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  room                Room?             @relation(fields: [roomId], references: [id], onDelete: NoAction)

  @@unique([schoolId, teacherAssignmentId, roomId])
  @@unique([schoolId, day, endTime, startTime, teacherAssignmentId])
  @@index([schoolId])
}

model CourseSession {
  id       String @id @default(cuid())
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id])

  chapter String // Ex: "Algèbre"
  title   String // Ex: "Les équations du second degré"

  date      DateTime  @default(now())
  startTime DateTime  @default(now()) @db.Time()
  endTime   DateTime? @db.Time()

  status SessionStatus @default(STARTED) // STARTED, FINISHED
}

/// *
/// * Etudiant
model Student {
  id             String    @id @default(cuid())
  profileId      String    @unique
  matricule      String
  enrollmentYear String
  enrollmentDate DateTime?
  studentNumber  Int       @default(autoincrement())

  bloodGroup             String?
  allergies              String?
  medicalCondition       String?
  schoolUserId           String                      @unique
  birthDate              DateTime                    @db.Date()
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  deletedAt              DateTime?
  birthPlace             String?
  nationality            String?
  previousClass          String?
  previousLevel          String?
  birthCertificateNumber String?
  previousSchool         String?
  schoolId               String
  classId                String
  transportMode          TransportMode               @default(WALK)
  status                 StudentStatus               @default(ACTIVE)
  results                AssessmentResult[]
  parentStudent          ParentStudent[]
  payments               Payment[]
  schoolClass            Class                       @relation(fields: [classId], references: [id])
  profile                Profile                     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  school                 School                      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolUser             SchoolUser                  @relation(fields: [schoolUserId], references: [id], onDelete: Cascade)
  disciplinaryActions    StudentDisciplinaryAction[]

  @@unique([matricule, schoolId])
  @@index([schoolUserId])
  @@index([schoolId])
}

model StudentDisciplinaryAction {
  id        String           @id @default(cuid())
  studentId String
  type      DisciplinaryType
  reason    String
  startDate DateTime         @db.Date()
  endDate   DateTime?        @db.Date()
  createdAt DateTime         @default(now())
  student   Student          @relation(fields: [studentId], references: [id])
}

/// *
/// * Parent
model Parent {
  id                String             @id @default(cuid())
  schoolUserId      String             @unique
  profession        String?
  isDelegate        Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  contactPreference ContactPreference? @default(WHATSAPP)
  schoolUser        SchoolUser         @relation(fields: [schoolUserId], references: [id], onDelete: Cascade)
  students          ParentStudent[]
}

/// *
/// * Parent - Student pivot
model ParentStudent {
  id           String       @id @default(cuid())
  studentId    String
  createdAt    DateTime     @default(now())
  parentId     String
  relationType RelationType
  parent       Parent       @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
}

model Invite {
  id          String     @id @default(cuid())
  email       String?
  schoolId    String
  studentId   String?
  token       String?    @unique
  relation    String?
  createdAt   DateTime   @default(now())
  expiresAt   DateTime
  used        Boolean    @default(false)
  role        SchoolRole
  message     String
  phoneNumber String?
  code        String?    @unique

  @@index([schoolId])
  @@index([studentId])
}

/// *
/// * Attendance

model AttendanceSession {
  id         String     @id @default(cuid())
  schoolId   String
  createdBy  String // schoolUserId
  createdAt  DateTime   @default(now())
  expiresAt  DateTime
  secretCode String // 6 digits
  targetRole SchoolRole // "TEACHER" ou "STAFF"
  isActive   Boolean    @default(true)

  school  School       @relation(fields: [schoolId], references: [id])
  creator SchoolUser   @relation(fields: [createdBy], references: [id])
  records Attendance[]

  @@index([expiresAt])
}

model Attendance {
  id       String @id @default(cuid())
  schoolId String

  // Pour un employé (teacher, student ou staff)
  schoolUserId   String?
  date           DateTime         @db.Date() // la date (sans heure)
  status         AttendanceStatus
  checkInTime    DateTime?        @db.Time() // heure de pointage (optionnel)
  recordedBy     String? // schoolUserId de l'agent qui a fait le pointage manuel
  sessionId      String? // si le pointage vient d'une session QR
  type           AtteandanceType  @default(DAILY)
  classSubjectId String?
  createdAt      DateTime         @default(now())

  classSuject ClassSubjects?     @relation(fields: [classSubjectId], references: [id])
  school      School             @relation(fields: [schoolId], references: [id])
  schoolUser  SchoolUser?        @relation(fields: [schoolUserId], references: [id])
  session     AttendanceSession? @relation(fields: [sessionId], references: [id])

  // Contraintes : une seule entrée par jour pour une même personne
  @@unique([schoolUserId, date, type, classSubjectId])
  @@index([schoolId])
  @@index([schoolUserId, date])
}

model Assessment {
  id             String             @id @default(cuid())
  title          String
  type           AssessmentType
  description    String?
  status         AssessmentStatus   @default(DRAFT)
  weight         Float?
  maxScore       Float
  teacherId      String
  classSubjectId String
  schoolId       String
  startDate      DateTime?
  endDate        DateTime?          @db.Date()
  dueDate        DateTime?          @db.Date()
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  classSubject   ClassSubjects      @relation(fields: [classSubjectId], references: [id])
  teacher        Teacher            @relation(fields: [teacherId], references: [id])
  results        AssessmentResult[]
  school         School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([title, classSubjectId, startDate])
  @@index([classSubjectId])
  @@index([teacherId])
}

model AssessmentResult {
  id           String     @id @default(cuid())
  assessmentId String
  studentId    String
  score        Float?
  grade        String?
  feedback     String?
  status       String?
  submittedAt  DateTime?
  gradedAt     DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student      Student    @relation(fields: [studentId], references: [id])

  @@unique([assessmentId, studentId])
  @@index([studentId])
  @@index([assessmentId])
}

model Subscription {
  id          String    @id @default(cuid())
  schoolId    String
  planId      String
  stripeSubId String?
  status      String
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  createdAt   DateTime  @default(now())
  plan        Plan      @relation(fields: [planId], references: [id])
  school      School    @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
}

model Teacher {
  id                String              @id @default(cuid())
  schoolUserId      String              @unique
  diploma           String?
  experience        String?
  hireDate          DateTime?
  isActive          Boolean
  salary            Float?
  department        String?
  specialization    String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?
  bio               String?
  cvUrl             String?
  assessments       Assessment[]
  supervisedClasses Class[]             @relation("ClassSupervisor")
  subject           Subject[]           @relation("MainTeacher")
  assignments       TeacherAssignment[]
  schoolUser        SchoolUser          @relation(fields: [schoolUserId], references: [id], onDelete: Cascade)

  @@map("Teachers")
}

model Staff {
  id            String        @id @default(cuid())
  schoolUserId  String        @unique
  hireDate      DateTime?
  position      StaffPosition @default(OTHER)
  positionOther String?
  salary        Float?
  departement   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  schoolUser SchoolUser @relation(fields: [schoolUserId], references: [id], onDelete: Cascade)

  @@index([schoolUserId])
  @@index([position])
}

/// *
/// * Billing
model Plan {
  id           String         @id @default(cuid())
  name         String
  stripeId     String?
  priceCents   Int
  features     String?
  createdAt    DateTime       @default(now())
  subscription Subscription[]
}

model Session {
  id           String   @id @default(cuid()) @map("sid")
  userId       String?
  createdAt    DateTime @default(now())
  expires      DateTime @map("expire")
  sessionToken String   @map("sess") @db.Text
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// *
/// * *  required models **
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String?
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Payment {
  id          String        @id @default(cuid())
  amount      Float
  netAmount   Float
  serviceFee  Float
  status      PaymentStatus @default(PENDING)
  type        PaymentType
  description String?
  providerRef String?       @unique
  payerPhone  String?
  payerName   String?
  payerId     String?
  schoolId    String
  studentId   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  payer       User?         @relation(fields: [payerId], references: [id])
  school      School        @relation(fields: [schoolId], references: [id])
  student     Student       @relation(fields: [studentId], references: [id])
}

model VerificationToken {
  createdAt DateTime  @default(now())
  expiresAt DateTime
  id        String    @id @default(cuid())
  method    String    @default("email")
  tokenHash String    @unique
  type      String    @default("password_reset")
  used      Boolean   @default(false)
  userId    String
  updateAt  DateTime? @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model VerificationCode {
  id        String    @id @default(cuid())
  userId    String
  expiresAt DateTime
  attempts  Int       @default(0)
  codeHash  String
  createdAt DateTime  @default(now())
  method    String    @default("whatsapp")
  type      String    @default("password_reset")
  used      Boolean   @default(false)
  updateAt  DateTime? @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([codeHash])
}

enum DisciplinaryType {
  SUSPENSION
  EXPULSION
  WARNING
}

enum SchoolRole {
  ADMIN
  TEACHER
  STUDENT
  PARENT
  STAFF
}

enum AssessmentType {
  EXAM
  ASSIGNMENT
  QUIZ
  TEST
  PRACTICAL
  ORAL
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum GlobalRole {
  SUPER_ADMIN
  USER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum RelationType {
  FATHER
  MOTHER
  GUARDIAN
  UNCLE
  OTHER
  GRAND_MOTHER
  GRAND_FATHER
  AUNT
}

enum ContactPreference {
  WHATSAPP
  EMAIL
  PHONE
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum StudentStatus {
  ACTIVE
  SUSPENDED
  EXPELLED
  TRANSFERRED
  DROPPED_OUT
  GRADUATED
  INACTIVE
  DECEASED
}

enum PaymentType {
  TUITION
  REGISTRATION
  CANTEEN
  TRANSPORT
  UNIFORM
  OTHER
}

enum SubjectCategory {
  SCIENTIFIC
  LITERARY
  GENERAL
  SPORT
}

enum TransportMode {
  BUS
  WALK
  CAR
  MOTO
  TAXI
  PARENT
  OTHER
}

enum LessonStatus {
  PLANNED // Prévue mais pas encore commencée
  ONGOING // En cours (optionnel mais utile)
  COMPLETED // Terminée (cours effectivement donné)
  CANCELLED // Annulée (ne comptera pas)
  POSTPONED // Reportée à une autre date
}

enum GroupType {
  SOLO
  MULTIPLE
}

enum SessionStatus {
  FINISHED
  STARTED
}

enum PermissionModule {
  ATTENDANCE // Gestion des présences
  ACADEMICS // Notes, bulletins, classes, matières
  USERS // Gestion des profs, élèves, parents, staff
  FINANCE // Frais de scolarité, paiements, salaires
  SETTINGS // Configuration de l'école
}

enum PermissionCode {
  // --- MODULE: ATTENDANCE ---
  MARK_STUDENT_ATTENDANCE
  MARK_TEACHER_ATTENDANCE
  MARK_STAFF_ATTENDANCE
  VIEW_ATTENDANCE_REPORTS

  // --- MODULE: ACADEMICS ---
  MANAGE_CLASSES
  MANAGE_SUBJECTS
  INPUT_GRADES
  PUBLISH_BULLETINS

  // --- MODULE: USERS ---
  CREATE_USER
  UPDATE_USER
  DELETE_USER
  MANAGE_USER_PERMISSIONS // Permet à un admin secondaire de modifier les accès

  // --- MODULE: FINANCE ---
  MANAGE_PAYMENTS
  VIEW_FINANCIAL_REPORTS
}

enum AtteandanceType {
  DAILY
  SUBJECT
}

enum StaffPosition {
  SECRETARY
  GUARDIAN
  SUPERVISOR
  ACCOUNTANT
  LIBRARIAN
  NURSE
  CLEANER
  MAINTENANCE
  OTHER
}
