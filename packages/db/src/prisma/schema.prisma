generator client {
  provider = "prisma-client-js"
  output   = "./client/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String              @id @default(cuid())
  email             String?             @unique
  password          String?
  globalRole        GlobalRole?         @default(USER)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?
  hasMembership     Boolean?            @default(false)
  profileCompleted  Boolean?            @default(false)
  username          String?             @unique
  isVerified        Boolean?
  phoneNumber       String?             @unique
  emailVerifiedAt   DateTime?
  emailVerified     Boolean?            @default(false)
  isActive          Boolean             @default(true)
  Account           Account[]
  payments          Payment[]
  profile           Profile?
  memberships       SchoolUser[]
  sessions          Session[]
  VerificationCode  VerificationCode[]
  VerificationToken VerificationToken[]

  @@index([email])
}

model Profile {
  id        String   @id @default(cuid())
  firstname String?
  lastname  String?
  gender    Gender?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String   @unique
  photo     String?
  address   String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  student   Student?
}

model School {
  id               String          @id @default(cuid())
  name             String
  slug             String?         @unique
  address          String
  code             String?         @unique
  planId           String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?
  inviationCode    String?
  logo             String?
  motto            String?
  assessments      Assessment[]
  orangeMerchantId String?
  paymentApiKey    String?
  walletBalance    Float           @default(0)
  attendances      Attendance[]
  classes          Class[]
  lessons          Lesson[]
  room             Room[]
  payment          Payment[]
  memberships      SchoolUser[]
  students         Student[]
  Subject          Subject[]
  subscriptions    Subscription[]
  settings         SchoolSettings?
}

model SchoolSettings {
  id String @id @default(cuid())

  schoolId       String @unique
  lessonDuration Int    @default(50) // durée d'une lesson (5O min)
  startHour      Int    @default(8) // début de cours (8 heure)
  endHour        Int    @default(18) // fin de cours (18 heure)
  daysOfWeek     Day[]
  breakStartHour Int    @default(12) // 12 heure (heure de pause)
  breakDuration  Int    @default(60) // 60 duration de la pause (60 min)
  school         School @relation(fields: [schoolId], references: [id])
}

/// *
/// * pivot User <-> School
model SchoolUser {
  id        String     @id @default(cuid())
  schoolId  String
  userId    String
  role      SchoolRole
  isOwner   Boolean    @default(false)
  createdAt DateTime   @default(now())
  Parent    Parent?
  school    School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  Staff     Staff?
  student   Student?
  teacher   Teacher?

  @@unique([schoolId, userId])
  @@index([schoolId])
  @@index([userId])
  @@index([role])
}

/// *
/// * Subject:  pivot ClassSubjects (explicit)
model Subject {
  id            String          @id @default(cuid())
  name          String
  code          String?
  category      SubjectCategory @default(GENERAL)
  mainTeacherId String?
  schoolId      String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  classSubjects ClassSubjects[]
  school        School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  mainTeacher   Teacher?        @relation("MainTeacher", fields: [mainTeacherId], references: [id])

  @@unique([name, schoolId])
  @@unique([code, schoolId])
  @@index([schoolId])
}

/// *
/// * Pivot explicit pour Class <-> Subject
model ClassSubjects {
  id          String       @id @default(cuid())
  groupId     String
  weeklyHours Int?
  coefficient Int          @default(1)
  subjectId   String
  teacherId   String?
  lessons     Lesson[]
  assessments Assessment[]
  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subject     Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher     Teacher?     @relation(fields: [teacherId], references: [id])

  @@unique([groupId, subjectId])
  @@index([groupId])
  @@index([subjectId])
  @@index([teacherId])
}

model Class {
  id            String    @id @default(cuid())
  name          String
  level         String
  section       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  schoolId      String
  teacherId     String?
  defaultRoomId String?
  supervisorId  String?
  groupId       String
  group         Group     @relation(fields: [groupId], references: [id])
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  supervisor    Teacher?  @relation("ClassSupervisor", fields: [supervisorId], references: [id])
  students      Student[]
  defaultRoom   Room?     @relation("DefaultRoom", fields: [defaultRoomId], references: [id], onDelete: SetNull)

  @@unique([name, schoolId])
  @@unique([defaultRoomId])
  @@index([schoolId])
}

model Group {
  id   String @id @default(cuid())
  name String // Ex: "11ème-Sciences-Lettres-HG"

  type          GroupType       @default(SOLO)
  classes       Class[]
  // Le contrat d'enseignement est lié au Groupe
  classSubjects ClassSubjects[]

  schoolId String
}

// *
// * Salle
model Room {
  id              String   @id @default(cuid())
  name            String // "Salle 1", "Labo Bio", "Salle Info"
  code            String? // Code court pour l'affichage
  type            String?  @default("CLASSIC") // "CLASSIQUE", "LABO", "SPORT"
  capacity        Int? // Pour éviter de mettre 100 élèves dans une salle de 30
  defaultForClass Class?   @relation("DefaultRoom")
  lessons         Lesson[]
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])

  @@unique([name, schoolId])
  @@unique([code, schoolId])
  @@index([schoolId])
}

model Lesson {
  id             String        @id @default(cuid())
  title          String?
  subtitle       String?
  startTime      DateTime
  status         LessonStatus  @default(PLANNED)
  day            Day
  endTime        DateTime
  schoolId       String
  roomId         String?
  classSubjectId String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  classSubject   ClassSubjects @relation(fields: [classSubjectId], references: [id])
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  room           Room?         @relation(fields: [roomId], references: [id], onDelete: NoAction)

  @@unique([roomId, schoolId, classSubjectId])
  @@unique([day, endTime, startTime, classSubjectId, schoolId])
}

/// *
/// * Etudiant
model Student {
  id             String    @id @default(cuid())
  profileId      String    @unique
  matricule      String
  enrollmentYear String
  enrollmentDate DateTime?

  bloodGroup       String?
  allergies        String?
  medicalCondition String?

  birthDate              DateTime
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  deletedAt              DateTime?
  birthPlace             String?
  nationality            String?
  previousClass          String?
  previousLevel          String?
  birthCertificateNumber String?
  previousSchool         String?
  schoolId               String
  classId                String
  transportMode          TransportMode               @default(WALK)
  schoolUserId           String                      @unique
  status                 StudentStatus               @default(ACTIVE)
  results                AssessmentResult[]
  attendances            Attendance[]
  parentStudent          ParentStudent[]
  payments               Payment[]
  schoolClass            Class                       @relation(fields: [classId], references: [id])
  profile                Profile                     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  school                 School                      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolUser             SchoolUser                  @relation(fields: [schoolUserId], references: [id], onDelete: Cascade)
  discipinaryActions     StudentDisciplinaryAction[]

  @@unique([matricule, schoolId])
  @@index([schoolUserId])
  @@index([schoolId])
}

model StudentDisciplinaryAction {
  id        String           @id @default(cuid())
  studentId String
  type      DisciplinaryType
  reason    String
  startDate DateTime
  endDate   DateTime?
  createdAt DateTime         @default(now())
  student   Student          @relation(fields: [studentId], references: [id])
}

/// *
/// * Parent
model Parent {
  id                String             @id @default(cuid())
  schoolUserId      String             @unique
  profession        String?
  isDelegate        Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  contactPreference ContactPreference? @default(WHATSAPP)
  schoolUser        SchoolUser         @relation(fields: [schoolUserId], references: [id], onDelete: Cascade)
  students          ParentStudent[]
}

/// *
/// * Parent - Student pivot
model ParentStudent {
  id           String       @id @default(cuid())
  studentId    String
  createdAt    DateTime     @default(now())
  parentId     String
  relationType RelationType
  parent       Parent       @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
}

model Invite {
  id          String     @id @default(cuid())
  email       String?
  schoolId    String
  studentId   String?
  token       String?    @unique
  relation    String?
  createdAt   DateTime   @default(now())
  expiresAt   DateTime
  used        Boolean    @default(false)
  role        SchoolRole
  message     String
  phoneNumber String?
  code        String?    @unique

  @@index([schoolId])
  @@index([studentId])
}

/// *
/// * Attendance
model Attendance {
  id        String           @id @default(cuid())
  studentId String
  date      DateTime
  status    AttendanceStatus
  createdAt DateTime         @default(now())
  teacherId String?
  schoolId  String
  school    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student   Student          @relation(fields: [studentId], references: [id])
  teacher   Teacher?         @relation(fields: [teacherId], references: [id])

  @@unique([studentId, date])
  @@index([studentId, date])
  @@index([schoolId])
}

model Assessment {
  id             String             @id @default(cuid())
  title          String
  type           AssessmentType
  description    String?
  status         AssessmentStatus   @default(DRAFT)
  weight         Float?
  maxScore       Float
  teacherId      String
  classSubjectId String
  schoolId       String
  startDate      DateTime?
  endDate        DateTime?
  dueDate        DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  classSubject   ClassSubjects      @relation(fields: [classSubjectId], references: [id])
  teacher        Teacher            @relation(fields: [teacherId], references: [id])
  results        AssessmentResult[]
  school         School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([title, classSubjectId, startDate])
  @@index([classSubjectId])
  @@index([teacherId])
}

model AssessmentResult {
  id           String     @id @default(cuid())
  assessmentId String
  studentId    String
  score        Float?
  grade        String?
  feedback     String?
  status       String?
  submittedAt  DateTime?
  gradedAt     DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student      Student    @relation(fields: [studentId], references: [id])

  @@unique([assessmentId, studentId])
  @@index([studentId])
  @@index([assessmentId])
}

model Subscription {
  id          String    @id @default(cuid())
  schoolId    String
  planId      String
  stripeSubId String?
  status      String
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  createdAt   DateTime  @default(now())
  plan        Plan      @relation(fields: [planId], references: [id])
  school      School    @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
}

model Session {
  userId       String?
  createdAt    DateTime @default(now())
  expires      DateTime @map("expire")
  sessionToken String   @unique @map("sess")
  id           String   @id @default(cuid()) @map("sid")
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Teacher {
  id                String          @id @default(cuid())
  schoolUserId      String          @unique
  diploma           String?
  experience        String?
  hireDate          DateTime?
  isActive          Boolean
  salary            Float?
  department        String?
  specialization    String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?
  bio               String?
  cvUrl             String?
  assessments       Assessment[]
  attendance        Attendance[]
  supervisedClasses Class[]         @relation("ClassSupervisor")
  subject           Subject[]       @relation("MainTeacher")
  classSubjects     ClassSubjects[]
  schoolUser        SchoolUser      @relation(fields: [schoolUserId], references: [id], onDelete: Cascade)

  @@map("Teachers")
}

model Staff {
  id           String     @id @default(cuid())
  schoolUserId String     @unique
  position     String
  hireDate     DateTime?
  salary       Float?
  departement  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  schoolUser   SchoolUser @relation(fields: [schoolUserId], references: [id], onDelete: Cascade)
}

/// *
/// * Billing
model Plan {
  id           String         @id @default(cuid())
  name         String
  stripeId     String?
  priceCents   Int
  features     String?
  createdAt    DateTime       @default(now())
  subscription Subscription[]
}

/// *
/// * * NextAuth required models **
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String?
  provider          String?
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Payment {
  id          String        @id @default(cuid())
  amount      Float
  netAmount   Float
  serviceFee  Float
  status      PaymentStatus @default(PENDING)
  type        PaymentType
  description String?
  providerRef String?       @unique
  payerPhone  String?
  payerName   String?
  payerId     String?
  schoolId    String
  studentId   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  payer       User?         @relation(fields: [payerId], references: [id])
  school      School        @relation(fields: [schoolId], references: [id])
  student     Student       @relation(fields: [studentId], references: [id])
}

model VerificationToken {
  createdAt DateTime  @default(now())
  expiresAt DateTime
  id        String    @id @default(cuid())
  method    String    @default("email")
  tokenHash String    @unique
  type      String    @default("password_reset")
  used      Boolean   @default(false)
  userId    String
  updateAt  DateTime? @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model VerificationCode {
  id        String    @id @default(cuid())
  userId    String
  expiresAt DateTime
  attempts  Int       @default(0)
  codeHash  String
  createdAt DateTime  @default(now())
  method    String    @default("whatsapp")
  type      String    @default("password_reset")
  used      Boolean   @default(false)
  updateAt  DateTime? @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([codeHash])
}

enum DisciplinaryType {
  SUSPENSION
  EXPULSION
  WARNING
}

enum SchoolRole {
  ADMIN
  TEACHER
  STUDENT
  PARENT
  STAFF
}

enum AssessmentType {
  EXAM
  ASSIGNMENT
  QUIZ
  TEST
  PRACTICAL
  ORAL
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum GlobalRole {
  SUPER_ADMIN
  USER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum RelationType {
  FATHER
  MOTHER
  GUARDIAN
  UNCLE
  OTHER
  GRAND_MOTHER
  GRAND_FATHER
  AUNT
}

enum ContactPreference {
  WHATSAPP
  EMAIL
  PHONE
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum StudentStatus {
  ACTIVE
  SUSPENDED
  EXPELLED
  TRANSFERRED
  DROPPED_OUT
  GRADUATED
  INACTIVE
  DECEASED
}

enum PaymentType {
  TUITION
  REGISTRATION
  CANTEEN
  TRANSPORT
  UNIFORM
  OTHER
}

enum SubjectCategory {
  SCIENTIFIC
  LITERARY
  GENERAL
  SPORT
}

enum TransportMode {
  BUS
  WALK
  CAR
  MOTO
  TAXI
  PARENT
  OTHER
}

enum LessonStatus {
  PLANNED // Prévue mais pas encore commencée
  ONGOING // En cours (optionnel mais utile)
  COMPLETED // Terminée (cours effectivement donné)
  CANCELLED // Annulée (ne comptera pas)
  POSTPONED // Reportée à une autre date
}

enum GroupType {
  SOLO
  MULTIPLE
}
