FROM node:lts-slim AS base
ENV PNPM_CONFIG_FETCH_TIMEOUT=900000
ENV PNPM_CONFIG_FETCH_RETRIES=10
ENV PNPM_CONFIG_NETWORK_CONCURRENCY=1
RUN npm install -g pnpm@11.9.0 nx
WORKDIR /repo

COPY pnpm-workspace.yaml package.json tsconfig.base.json nx.json ./
COPY apps/service-auth ./apps/service-auth
COPY packages/messaging ./packages/messaging
COPY packages/contracts ./packages/contracts

RUN pnpm install --no-frozen-lockfile

CMD ["pnpm", "nx", "start:dev", "service-auth", "--host", "0.0.0.0"]
