generator client {
  provider = "prisma-client-js"
  output   = "./client/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String              @id @default(cuid())
  email             String?             @unique
  password          String?
  globalRole        GlobalRole?         @default(USER)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?
  emailVerifiedAt   DateTime?
  emailVerified     Boolean?            @default(false)
  hasMembership     Boolean?            @default(false)
  profileCompleted  Boolean?            @default(false)
  username          String?             @unique
  isVerified        Boolean?
  phoneNumber       String?             @unique
  Account           Account[]
  profile           Profile?
  memberships       SchoolUser[]
  sessions          Session[]
  VerificationCode  VerificationCode[]
  VerificationToken VerificationToken[]
  payments          Payment[]

  @@index([email])
}

model Profile {
  id        String    @id @default(cuid())
  firstname String?
  lastname  String?
  address   String?
  gender    Gender?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userId    String    @unique
  photo     String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  student   Student[]
}

model School {
  id            String    @id @default(cuid())
  name          String
  slug          String?   @unique
  address       String
  code          String?   @unique
  planId        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  inviationCode String?
  logo          String?
  motto         String?

  orangeMerchantId String?
  paymentApiKey    String?
  walletBalance    Float     @default(0)
  payment          Payment[]

  classes       Class[]
  lessons       Lesson[]
  memberships   SchoolUser[]
  students      Student[]
  Subject       Subject[]
  subscriptions Subscription[]
  attendances   Attendance[]
}

/// *
/// * pivot User <-> School
model SchoolUser {
  id           String         @id @default(cuid())
  schoolId     String
  userId       String
  role         SchoolRole
  isOwner      Boolean        @default(false)
  createdAt    DateTime       @default(now())
  class        Class[]
  classTeacher ClassTeacher[]
  school       School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  Staff        Staff?
  subject      Subject[]
  teacher      Teacher?
  Parent       Parent?
  student      Student?

  @@unique([schoolId, userId])
  @@index([schoolId])
  @@index([userId])
  @@index([role])
}

/// *
/// * Subject: utilise pivot ClassSubjects (explicit)
model Subject {
  id            String          @id @default(cuid())
  name          String          @unique
  code          String?
  schoolId      String
  teacherId     String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  schoolUserId  String?
  ClassSubjects ClassSubjects[]
  school        School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolUser    SchoolUser?     @relation(fields: [schoolUserId], references: [id])
  teacher       Teacher?        @relation(fields: [teacherId], references: [id])
  lessons       Lesson[]
  assessments   Assessment[]

  @@unique([code, schoolId])
  @@index([schoolId])
}

/// *
/// * Pivot explicit pour Class <-> Subject
model ClassSubjects {
  id        String   @id @default(cuid())
  classId   String
  subjectId String
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
  @@index([classId])
  @@index([subjectId])
  @@index([teacherId])
}

model Class {
  id           String   @id @default(cuid())
  name         String   @unique
  level        String
  section      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  schoolId     String
  teacherId    String?
  supervisorId String?

  school     School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher    SchoolUser? @relation(fields: [teacherId], references: [id])
  supervisor Teacher?    @relation("ClassSupervisor", fields: [supervisorId], references: [id])

  classSubjects ClassSubjects[]
  classTeacher  ClassTeacher[]
  lessons       Lesson[]
  students      Student[]
  assessment    Assessment[]

  @@index([schoolId])
}

/// *
/// * Pivot Prof <-> Classe
model ClassTeacher {
  id            String      @id @default(cuid())
  classId       String
  name          String?
  teacherId     String
  createdAt     DateTime    @default(now())
  staffMemberId String?
  schoolUserId  String?
  class         Class       @relation(fields: [classId], references: [id], onDelete: Cascade)
  SchoolUser    SchoolUser? @relation(fields: [schoolUserId], references: [id])
  teacher       Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([classId, teacherId])
  @@index([classId])
  @@index([teacherId])
}

/// *
/// * Etudiant
model Student {
  id             String             @id @default(cuid())
  profileId      String
  schoolUserId   String             @unique
  matricule      String
  enrollmentYear String
  birthDate      DateTime
  schoolId       String
  classId        String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?
  birthPlace     String?
  fatherName     String?
  motherName     String?
  nationality    String?
  attendances    Attendance[]
  parentStudent  ParentStudent[]
  schoolClass    Class?             @relation(fields: [classId], references: [id])
  profile        Profile            @relation(fields: [profileId], references: [id])
  school         School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolUser     SchoolUser         @relation(fields: [schoolUserId], references: [id], onDelete: Cascade)
  payments       Payment[]
  results        AssessmentResult[]

  @@unique([matricule, schoolId])
  @@index([schoolUserId])
  @@index([schoolId])
}

/// *
/// * Parent
model Parent {
  id                String            @id @default(cuid())
  schoolUserId      String            @unique
  profession        String?
  isDelegate        Boolean           @default(false)
  createdAt         DateTime          @default(now())
  contactPreference ContactPreference
  updatedAt         DateTime          @updatedAt
  schoolUser        SchoolUser        @relation(fields: [schoolUserId], references: [id], onDelete: Cascade)
  students          ParentStudent[]
}

/// *
/// * Parent - Student pivot
model ParentStudent {
  id           String       @id @default(cuid())
  parentId     String
  studentId    String
  relationType RelationType
  createdAt    DateTime     @default(now())
  parent       Parent       @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
}

model Invite {
  id          String     @id @default(cuid())
  email       String?
  phoneNumber String?
  schoolId    String
  studentId   String?
  token       String?    @unique
  code        String?    @unique
  relation    String?
  createdAt   DateTime   @default(now())
  expiresAt   DateTime
  used        Boolean    @default(false)
  role        SchoolRole
  message     String

  @@index([schoolId])
  @@index([studentId])
}

/// *
/// * Attendance
model Attendance {
  id        String           @id @default(cuid())
  studentId String
  date      DateTime
  status    AttendanceStatus
  schoolId  String
  createdAt DateTime         @default(now())
  teacherId String?
  student   Student          @relation(fields: [studentId], references: [id])
  teacher   Teacher?         @relation(fields: [teacherId], references: [id])
  school    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([studentId, date])
  @@index([schoolId])
}

model Lesson {
  id        String   @id @default(cuid())
  name      String
  startTime DateTime
  day       Day
  endTime   DateTime
  teacherId String
  classId   String
  subjectId String
  schoolId  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject Subject @relation(fields: [subjectId], references: [id])
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

/// *
/// * Assessments

model Assessment {
  id          String           @id @default(cuid())
  title       String
  type        AssessmentType
  description String?
  status      AssessmentStatus @default(DRAFT)
  weight      Float?
  maxScore    Float

  teacherId String
  subjectId String
  classId   String

  startDate DateTime?
  endDate   DateTime?
  dueDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class   Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher Teacher            @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject            @relation(fields: [subjectId], references: [id])
  results AssessmentResult[]

  @@index([classId])
  @@index([teacherId])
  @@index([subjectId])
}

model AssessmentResult {
  id           String    @id @default(cuid())
  assessmentId String
  studentId    String
  score        Float?
  grade        String?
  feedback     String?
  status       String?
  submittedAt  DateTime?
  gradedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id])

  @@unique([assessmentId, studentId])
  @@index([studentId])
  @@index([assessmentId])
}

/// *
/// * Billing
model Plan {
  id           String         @id @default(cuid())
  name         String
  stripeId     String?
  priceCents   Int
  features     String?
  createdAt    DateTime       @default(now())
  subscription Subscription[]
}

model Subscription {
  id          String    @id @default(cuid())
  schoolId    String
  planId      String
  stripeSubId String?
  status      String
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  createdAt   DateTime  @default(now())
  plan        Plan      @relation(fields: [planId], references: [id])
  school      School    @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
}

/// *
/// * * NextAuth required models **
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String?
  provider          String?
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Payment {
  id          String        @id @default(cuid())
  amount      Float
  netAmount   Float
  serviceFee  Float
  status      PaymentStatus @default(PENDING)
  type        PaymentType
  description String?
  providerRef String?       @unique

  payerPhone String?
  payerName  String?

  payerId String?
  payer   User?   @relation(fields: [payerId], references: [id])

  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id])
  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  createdAt DateTime  @default(now())
  expiresAt DateTime
  id        String    @id @default(cuid())
  method    String    @default("email")
  tokenHash String    @unique
  type      String    @default("password_reset")
  used      Boolean   @default(false)
  userId    String
  updateAt  DateTime? @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model VerificationCode {
  id        String    @id @default(cuid())
  userId    String
  expiresAt DateTime
  attempts  Int       @default(0)
  codeHash  String
  createdAt DateTime  @default(now())
  method    String    @default("whatsapp")
  type      String    @default("password_reset")
  used      Boolean   @default(false)
  updateAt  DateTime? @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([codeHash])
}

model Session {
  userId       String?
  createdAt    DateTime @default(now())
  expires      DateTime @map("expire")
  sessionToken String   @unique @map("sess")
  id           String   @id @default(cuid()) @map("sid")
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Teacher {
  id                String          @id @default(cuid())
  schoolUserId      String          @unique
  diploma           String?
  experience        String?
  hireDate          DateTime?
  isActive          Boolean
  salary            Float?
  departement       String?
  specialization    String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  attendance        Attendance[]
  classTeacher      ClassTeacher[]
  Subject           Subject[]
  schoolUser        SchoolUser      @relation(fields: [schoolUserId], references: [id], onDelete: Cascade)
  lessons           Lesson[]
  supervisedClasses Class[]         @relation("ClassSupervisor")
  classSubjects     ClassSubjects[]
  assessments       Assessment[]

  @@map("Teachers")
}

model Staff {
  id           String     @id @default(cuid())
  schoolUserId String     @unique
  position     String
  hireDate     DateTime?
  salary       Float?
  departement  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  schoolUser   SchoolUser @relation(fields: [schoolUserId], references: [id], onDelete: Cascade)
}

enum SchoolRole {
  ADMIN
  TEACHER
  STUDENT
  PARENT
  STAFF
}

enum AssessmentType {
  EXAM
  ASSIGNMENT
  QUIZ
  TEST
  PRACTICAL
  ORAL
}

enum AssessmentStatus {
  DRAFT
  BUBLISHED
  CLOSED
}

enum GlobalRole {
  SUPER_ADMIN
  USER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum RelationType {
  FATHER
  MOTHER
  GUARDIAN
  UNCLE
  OTHER
  GRAND_MOTHER
  GRAND_FATHER
  AUNT
}

enum ContactPreference {
  WHATSAPP
  EMAIL
  PHONE
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentType {
  TUITION // Scolarité
  REGISTRATION // Inscription
  CANTEEN // Cantine
  TRANSPORT // Transport
  UNIFORM // Tenue
  OTHER
}
