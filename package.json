{
  "private": true,
  "name": "stackschool-monorepo",
  "version": "1.0.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "resolutions": {
    "react": "^19.2.3"
  },
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "dev:web": "pnpm --filter @stackschool/web run dev",
    "dev:mobile": "pnpm --filter @stackschool/mobile run start",
    "db:generate": "pnpm --filter @stackschool/db run generate",
    "codegen": "graphql-codegen --config codegen.ts",
    "dev:api": "nx run-many --targets=dev --projects=@stackschool/shared,@stackschool/db & nx dev @stackschool/api-nest",
    "build:api": "nx build @stackschool/api-nest",
    "build:all": "nx run-many -t build",
    "build:db": "nx run-many -t build --projects=db-operations,db-auth,db-academic,db-core"
  },
  "devDependencies": {
    "@0no-co/graphqlsp": "^1.17.5",
    "@babel/core": "^7.29.7",
    "@eslint/eslintrc": "^3.3.6",
    "@graphql-codegen/cli": "^7.3.1",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^5.1.0",
    "@graphql-codegen/typescript-react-query": "^7.0.5",
    "@graphql-codegen/typescript-resolvers": "^5.1.8",
    "@parcel/watcher": "^2.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.102.3",
    "@tanstack/react-query-devtools": "^5.102.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^10.9.1",
    "jest": "^30.4.2",
    "nx": "23.0.1",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ts-node-dev": "^2.0.0"
  },
  "packageManager": "pnpm@11.22.0"
}
