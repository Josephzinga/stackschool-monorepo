{
  "name": "@stackschool/db-auth",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "migrate": "prisma migrate dev",
    "seed": "ts-node-dev src/prisma/seed.ts",
    "build": "tsup src/index.ts --format esm  && tsc --emitDeclarationOnly --declaration --outDir dist",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "build:bun": "bun build --target=node --outfile=dist/index.ts ./src/index.js",
    "build:1": "rm -rf dist && bun build ./src/index.ts --outdir ./dist --target node && tsc --emitDeclarationOnly --outDir dist"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "catalog:",
    "@prisma/extension-accelerate": "^2.0.2",
    "prisma": "catalog:",
    "tsup": "^8.5.1"
  },
  "dependencies": {
    "@prisma/client": "catalog:"
  }
}
