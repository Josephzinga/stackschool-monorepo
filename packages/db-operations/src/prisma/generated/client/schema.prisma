generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

model AttendanceSession {
  id         String       @id @default(cuid())
  schoolId   String
  createdBy  String // schoolUserId
  createdAt  DateTime     @default(now())
  expiresAt  DateTime
  secretCode String // 6 digits
  targetRole SchoolRole // "TEACHER" ou "STAFF"
  isActive   Boolean      @default(true)
  records    Attendance[]

  @@index([expiresAt])
}

model Attendance {
  id             String             @id @default(cuid())
  schoolId       String
  schoolUserId   String?
  date           DateTime           @db.Date() // la date (sans heure)
  status         AttendanceStatus
  checkInTime    DateTime?          @db.Time() // heure de pointage (optionnel)
  recordedBy     String? // schoolUserId de l'agent qui a fait le pointage manuel
  sessionId      String? // si le pointage vient d'une session QR
  type           AttendanceType     @default(DAILY)
  classSubjectId String?
  createdAt      DateTime           @default(now())
  session        AttendanceSession? @relation(fields: [sessionId], references: [id])

  // Contraintes : une seule entrée par jour pour une même personne
  @@unique([schoolUserId, date, type, classSubjectId])
  @@index([schoolId])
  @@index([schoolUserId, date])
}

model Payment {
  id          String        @id @default(cuid())
  amount      Float
  netAmount   Float
  serviceFee  Float
  status      PaymentStatus @default(PENDING)
  type        PaymentType
  description String?
  providerRef String?       @unique
  payerPhone  String?
  payerName   String?
  payerId     String?
  schoolId    String
  studentId   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum SchoolRole {
  ADMIN
  TEACHER
  STUDENT
  PARENT
  STAFF
}

enum AttendanceType {
  DAILY
  SUBJECT
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentType {
  TUITION
  REGISTRATION
  CANTEEN
  TRANSPORT
  UNIFORM
  OTHER
}
